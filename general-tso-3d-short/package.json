{
  "name": "general-tso-3d-short",
  "version": "1.0.0",
  "private": true,
  "description": "30-секундний вертикальний 3D-шортс «Курка генерала Цо» — Китайський Привіт, шеф Сян",
  "type": "module",
  "scripts": {
    "prompts": "node tools/build-prompts.mjs",
    "validate": "node tools/validate-script.mjs",
    "assets": "node tools/scan-assets.mjs",
    "prestudio": "npm run assets",
    "studio": "remotion studio",
    "prerender": "npm run validate && npm run assets",
    "render": "remotion render GeneralTso30s out/general_tso_30s.mp4",
    "prerender:guides": "npm run validate && npm run assets",
    "render:guides": "remotion render GeneralTso30s out/general_tso_30s_guides.mp4 --props=props/guides.json",
    "prestill": "npm run assets",
    "still": "remotion still GeneralTso30s out/preview.png",
    "pretypecheck": "npm run assets",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jost": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
